@model Department
<form action="/department/saveadd" method="post">

    <div>
        <label>Name</label>
        <input type="text" name="Name" value="@Model?.Name" class="form-control form" />
    </div>
    <div>
        <label>Manager Name</label>
        <input type="text" name="ManagerName" value="@Model?.ManagerName" class="form-control form" />
    </div>

    <input type="submit" value="Create" />
    

</form>
<a href="/Department" class="btn">Back to list</a>
