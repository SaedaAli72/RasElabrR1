@model List<Department>

@{
    ViewData["title"] = "Department";
    Layout = "_Layout1";
}

    <a href="/Department/add" class="btn btn-primary">new</a>
<table class="table table-bordered table-hovered">

    <tr>
        <th>N.</th>
        <th>Name</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
        </tr>
    }

</table>